{
  "expo": {
    "name": "QuickPipe",
    "slug": "quickpipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#090D16"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quickpipe.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.quickpipe.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.DETECT_SCREEN_CAPTURE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "5fa37b3f-4cbd-4af9-b440-7492e65f8de1"
      }
    }
  }
}
